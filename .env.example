# Copy this file to .env. Never commit the resulting .env file.
KAIROS_DB_NAME=kairos
KAIROS_DB_USER=kairos
KAIROS_DB_PASSWORD=replace_with_a_local_password
KAIROS_DB_PORT=5432
KAIROS_API_PORT=8080
KAIROS_WEB_PORT=5173
KAIROS_KEYCLOAK_PORT=8081
KAIROS_KEYCLOAK_ADMIN=admin
KAIROS_KEYCLOAK_ADMIN_PASSWORD=replace_with_a_local_admin_password

# Google login stays disabled until OAuth credentials are configured.
KAIROS_GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=not-configured
GOOGLE_CLIENT_SECRET=not-configured
